# A01 Production Environment
APP_ENV=production

A01_AGENT_DEBUG=false
A01_AGENT_MAX_WORKERS=8

A01_RPC_TIMEOUT_SECONDS=20
A01_RPC_RETRY_COUNT=5

A01_CHAIN_CONFIRMATIONS=12

A01_DB_URL=postgresql+asyncpg://user:pass@db:5432/a01
A01_DB_ECHO=false

A01_AI_PROVIDER=mock
A01_LOG_LEVEL=INFO
A01_LOG_JSON_LOGS=true
A01_CACHE_ENABLED=true
A01_CACHE_MAX_SIZE=4096
A01_CACHE_TTL_SECONDS=300

A01_SEC_SECRET_DIR=/run/secrets
A01_SEC_ENV_PREFIX=A01_SECRET_
A01_SEC_ENABLE_STRICT_SECRETS=true
