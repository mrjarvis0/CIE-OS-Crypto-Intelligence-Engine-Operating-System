# ==============================================================================
# A02 News Intelligence Agent — environment variables
# Copy to repo-root .env (existing file) and fill in keys you have.
# All vars are OPTIONAL — the agent runs in degraded mode without keys.
# ==============================================================================

# --- Agent --------------------------------------------------------------------
A02_AGENT_ENVIRONMENT=development
A02_AGENT_DEBUG=true

# --- Ingestion ----------------------------------------------------------------
A02_INGESTION_POLL_INTERVAL_SECONDS=60
A02_INGESTION_MAX_ITEMS_PER_FETCH=100
A02_INGESTION_NEWS_HISTORY_DAYS=30

# --- News APIs ----------------------------------------------------------------
A02_NEWS_TIINGO_API_KEY=
A02_NEWS_ALPACA_API_KEY=
A02_NEWS_ALPACA_SECRET_KEY=
A02_NEWS_FINNHUB_API_KEY=
A02_NEWS_NEWSAPI_KEY=
A02_NEWS_FINANCIALJUICE_API_KEY=

# --- Social -------------------------------------------------------------------
A02_SOCIAL_REDDIT_CLIENT_ID=
A02_SOCIAL_REDDIT_CLIENT_SECRET=
A02_SOCIAL_REDDIT_USER_AGENT=cie-os-a02/0.1
A02_SOCIAL_SUBREDDITS=wallstreetbets,cryptocurrency,stocks
A02_SOCIAL_ENABLE_X_STREAM=false
# Phase 6
A02_SOCIAL_TELEGRAM_BOT_TOKEN=
A02_SOCIAL_TELEGRAM_CHAT_IDS=
A02_SOCIAL_X_BEARER_TOKEN=
A02_SOCIAL_X_SEARCH_QUERY=crypto OR bitcoin OR ethereum OR stock OR finance lang:en -is:retweet

# --- Market data --------------------------------------------------------------
A02_MARKET_ALPHA_VANTAGE_API_KEY=
A02_MARKET_ENABLE_CRYPTO=true
A02_MARKET_ENABLE_STOCKS=true
A02_MARKET_ENABLE_FOREX=false

# --- Narrative / detection ----------------------------------------------------
A02_NARRATIVE_WINDOW_HOURS=24
A02_NARRATIVE_MIN_MENTIONS=3

# --- Models -------------------------------------------------------------------
A02_MODEL_FAKE_DETECTOR_MODEL=bert-base-uncased
A02_MODEL_FAKE_DETECTOR_THRESHOLD=0.5
A02_MODEL_IMPACT_MODEL_TYPE=rules
A02_MODEL_MIN_CONFIDENCE=0.6
